{
    "$schema": "https://images.onerom.org/configs/schema.json",
    "version": 1,
    "name": "VIC-20 Bootloader (NTSC)",
    "description": "Reference bootloader, stock kernal and the RBCP test applications",
    "categories": [
        "computer",
        "commodore",
        "vic20",
        "rbcp"
    ],
    "chip_sets": [
        {
            "type": "single",
            "chips": [
                {
                    "type": "system_plugin",
                    "plugin": "usb"
                }
            ]
        },
        {
            "type": "single",
            "chips": [
                {
                    "type": "user_plugin",
                    "plugin": "host-control"
                }
            ]
        },
        {
            "type": "single",
            "chips": [
                {
                    "label": "Bootloader",
                    "file": "https://images.onerom.org/roms/host-control/vic20-boot/latest/vic20_boot_ntsc.bin",
                    "type": "2364",
                    "cs1": "active_low"
                }
            ]
        },
        {
            "type": "single",
            "chips": [
                {
                    "label": "Kernal 901486-06",
                    "file": "http://www.zimmers.net/anonftp/pub/cbm/firmware/computers/vic20/kernal.901486-06.bin",
                    "type": "2364",
                    "cs1": "active_low"
                }
            ]
        },
        {
            "type": "single",
            "chips": [
                {
                    "label": "Terminal",
                    "file": "https://images.onerom.org/roms/host-control/vic20-rbcp-term/latest/vic20_term_ntsc.bin",
                    "type": "2364",
                    "cs1": "active_low"
                }
            ]
        },
        {
            "type": "single",
            "chips": [
                {
                    "label": "Aux I/O Tester",
                    "file": "https://images.onerom.org/roms/host-control/vic20-aux-io/latest/vic20_auxio_ntsc.bin",
                    "type": "2364",
                    "cs1": "active_low"
                }
            ]
        },
        {
            "type": "single",
            "chips": [
                {
                    "label": "Pipe Throughput",
                    "file": "https://images.onerom.org/roms/host-control/vic20-pipe-test/latest/vic20_pipe_ntsc.bin",
                    "type": "2364",
                    "cs1": "active_low"
                }
            ]
        },
        {
            "type": "single",
            "chips": [
                {
                    "label": "Reliability Meter",
                    "file": "https://images.onerom.org/roms/host-control/vic20-rbcp-stress/latest/vic20_meter_ntsc.bin",
                    "type": "2364",
                    "cs1": "active_low"
                }
            ]
        }
    ]
}